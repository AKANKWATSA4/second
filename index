  #fy-ledger-root .attention-row .who-task { display: flex; gap: 8px; align-items: baseline; }
  #fy-ledger-root .attention-row .p-name { color: #FFFFFF; font-weight: 700; }
  #fy-ledger-root .attention-empty { padding: 14px 16px; color: var(--text-muted); font-size: 13px; }

  #fy-ledger-root .month-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 16px; }
