  }

  #fy-ledger-root .attention {
    margin-top: 22px; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 4px 0;
  }
  #fy-ledger-root .attention h3 {
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ura-yellow);
    padding: 12px 16px 4px 16px; margin: 0; font-family: 'IBM Plex Mono', monospace;
  }
  #fy-ledger-root .attention-row {
    display: flex; justify-content: space-between; align-items: center; padding: 8px 16px;
    font-size: 13px; border-top: 1px solid var(--border);
