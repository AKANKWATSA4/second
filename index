  }
  #fy-ledger-root .obj-add-form select {
    background: var(--panel-alt); border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; padding: 9px 10px; font-size: 12.5px; font-family: inherit;
  }
  #fy-ledger-root .obj-add-form button {
