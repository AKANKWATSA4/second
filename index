  #fy-ledger-root .obj-add-form { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  #fy-ledger-root .obj-add-form input {
    flex: 1; min-width: 180px; background: var(--panel-alt); border: 1px solid var(--border); color: var(--text);
