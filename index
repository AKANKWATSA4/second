  function renderMyTasks(){
    const isManager = me === 'manager';
    if (!me) return `<div class="empty-month">Pick who you are from the dropdown above to see tasks.</div>`;
 
    const targetId = isManager
      ? (viewingPersonId || (state.people[0] && state.people[0].id))
      : (viewingPersonId || me);
