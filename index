  #fy-ledger-root .cell-task.done { background: rgba(79,209,255,0.18); border-color: var(--teal); color: var(--teal); }
  #fy-ledger-root .cell-task.due { background: rgba(255,215,0,0.20); border-color: var(--amber); color: #FFE873; }
  #fy-ledger-root .cell-task.overdue { background: rgba(255,107,107,0.20); border-color: var(--red); color: var(--red); font-weight: 700; }
