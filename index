<body style="margin:0; padding:16px; background:#ECECFE; font-family: 'IBM Plex Sans', -apple-system, sans-serif;">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Limelight&display=swap');

  #fy-ledger-root {
    --bg: #0B4C8C;
    --panel: #0F5390;
    --panel-alt: #123F72;
    --border: rgba(255,255,255,0.30);
    --text: #FFFFFF;
    --text-muted: #C7DCF5;
    --teal: #4FD1FF;
    --amber: #FFD700;
    --red: #FF6B6B;
    --green: #3DDC84;
    --indigo: #2E86D8;
    --ura-yellow: #FFD700;
    --ura-blue: #2E86D8;
 
    background: linear-gradient(135deg, #2E86D8 0%, #0B4C8C 45%, #003D7A 100%);
    color: var(--text);
    font-family: 'IBM Plex Sans', -apple-system, sans-serif;
    border-radius: 14px;
    padding: 0;
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  #fy-ledger-root * { box-sizing: border-box; }
  #fy-ledger-root .brand-stripe {
    height: 6px; width: 100%;
    background: linear-gradient(90deg, var(--ura-blue) 0%, #1B5FA0 45%, var(--ura-yellow) 100%);
  }
  #fy-ledger-root .mono { font-family: 'IBM Plex Mono', monospace; }
  #fy-ledger-root .display { font-family: 'Space Grotesk', sans-serif; }
  #fy-ledger-root .person-name { font-weight: 800; color: var(--indigo); letter-spacing: 0.01em; }

  #fy-ledger-root .refresh-btn {
    background: var(--panel-alt); border: 1px solid var(--indigo); color: #FFFFFF; border-radius: 7px;
    padding: 6px 12px; font-size: 12px; cursor: pointer; font-family: 'IBM Plex Mono', monospace;
    font-weight: 700; transition: background 0.12s ease, transform 0.06s ease;
  }
  #fy-ledger-root .refresh-btn:hover { background: rgba(46,134,216,0.35); }
  #fy-ledger-root .refresh-btn:active { transform: scale(0.96); background: var(--indigo); color: #FFFFFF; }
  #fy-ledger-root .refresh-btn:disabled { opacity: 0.6; cursor: default; transform: none; }

  #fy-ledger-root .topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; border-bottom: 1px solid var(--border);
    background: linear-gradient(120deg, #2E86D8 0%, #0B4C8C 55%, #003D7A 100%);
    flex-wrap: wrap; gap: 12px;
  }
  #fy-ledger-root .brand { display: flex; flex-direction: column; gap: 2px; padding-left: 58px; position: relative; }
  #fy-ledger-root .brand::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #fff;
    border: 2px solid var(--ura-yellow);
    box-shadow: 0 2px 10px rgba(255,215,0,.35);
  }
  #fy-ledger-root .brand .eyebrow {
    font-size: 12px; letter-spacing: 0.1em; color: #123F72;
    text-transform: uppercase; font-family: 'IBM Plex Mono', monospace;
