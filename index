  #fy-ledger-root td.name-col { font-weight: 600; font-size: 13px; padding: 10px 12px; white-space: nowrap; color: #FFFFFF; }
  #fy-ledger-root td.name-col .pct { display:block; font-size:10px; color: var(--text-muted); font-weight: 400; margin-top:2px; }

  #fy-ledger-root .cell {
    width: 108px; min-height: 34px; height: 118px; margin: 5px auto;
    border-radius: 6px; padding: 4px; display: flex; flex-direction: column; gap: 3px;
    cursor: pointer; border: 1px solid var(--border); background: var(--panel);
