    const person = state.people.find(p=>p.id===targetId);
    // canEdit gates deletion -- manager-only, on purpose (people can add
    // their own tasks but not remove them once logged).
    const canEdit = isManager;
    // canAddTask gates the "Add a task" row -- the manager can add for
    // anyone they're assigning to, and each person can add tasks to
    // their own list, but not to a teammate's.
    const canAddTask = isManager || targetId===me;
    const canToggle = !isManager && targetId===me;
 
    const managerPicker = isManager ? `
      <div class="readonly-banner" style="border-color:var(--indigo);">
        <span>Assigning tasks for</span>
        <select id="managerPersonSelect" style="background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 8px;">
          ${state.people.map(p=>`<option value="${p.id}" ${p.id===targetId?'selected':''} style="font-weight:700;color:#0303F2;">${escapeHtml(p.name)}</option>`).join('')}
        </select>
      </div>` : '';

    const deliverablesToggle = isManager ? `
      <div class="obj-subnav" style="margin-bottom:14px;">
