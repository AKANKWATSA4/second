  #fy-ledger-root .month-tab.active { background: var(--indigo); color: #FFFFFF; border-color: var(--indigo); font-weight: 700; }
  #fy-ledger-root .month-tab.now::after {
    content: '•'; position: absolute; top: -2px; right: 3px; color: var(--amber); font-size: 16px;
  }

  #fy-ledger-root .readonly-banner {
    background: rgba(46,134,216,0.20); border: 1px solid var(--indigo); color: #FFFFFF;
    font-size: 12.5px; padding: 8px 12px; border-radius: 8px; margin-bottom: 14px; display:flex; justify-content:space-between; align-items:center;
  }
  #fy-ledger-root .readonly-banner button {
    background: var(--indigo); color: #FFFFFF; border: none; border-radius: 6px; padding: 5px 10px; font-size: 12px; cursor: pointer; font-weight: 600;
  }

  #fy-ledger-root .task-list { display: flex; flex-direction: column; gap: 8px; }
  #fy-ledger-root .task {
    display: flex; align-items: center; gap: 10px; background: var(--panel);
    border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px;
  }
  #fy-ledger-root .task.done { opacity: 0.65; }
  #fy-ledger-root .check {
    width: 22px; height: 22px; border-radius: 6px; border: 1.5px solid var(--text-muted);
    display: flex; align-items: center; justify-content: center; cursor: pointer; flex: none;
    font-size: 13px; color: transparent;
  }
  #fy-ledger-root .task.done .check { background: var(--teal); border-color: var(--teal); color: #003D7A; }
  #fy-ledger-root .task-title { flex: 1; font-size: 14px; color: #FFFFFF; }
  #fy-ledger-root .task.done .task-title { text-decoration: line-through; color: var(--text-muted); }
  #fy-ledger-root .stamp {
    font-family: 'IBM Plex Mono', monospace; font-size: 9.5px; letter-spacing: 0.08em; padding: 3px 7px;
