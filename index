  function renderDashboard(){
    const totals = state.tasks.length;
    const done = state.tasks.filter(t=>t.done).length;
    const overdue = state.tasks.filter(t=>!t.done && t.month<CUR_MONTH).length;
 
    const rows = state.people.map(p => {
      const stats = personStats(p.id);
      const cells = MONTH_NAMES.map((mn,idx) => {
        const m = idx+1;
        const list = tasksFor(p.id, m);
        if (!list.length){
          return `<td><div class="cell empty-cell" data-goto="${p.id}|${m}" title="${mn}: no tasks">–</div></td>`;
        }
        const key = p.id + '|' + m;
        const totalPages = Math.ceil(list.length / CELL_PAGE_SIZE);
        let pg = cellPage[key] || 0;
        if (pg >= totalPages) pg = totalPages - 1;
        if (pg < 0) pg = 0;
        cellPage[key] = pg;
        const pageItems = list.slice(pg*CELL_PAGE_SIZE, pg*CELL_PAGE_SIZE + CELL_PAGE_SIZE);
        const chips = pageItems.map(t => {
          const st = t.done ? 'done' : (m<CUR_MONTH ? 'overdue' : (m===CUR_MONTH ? 'due' : 'upcoming'));
          return `<div class="cell-task ${st}" title="${escapeHtml(t.title)}">${escapeHtml(t.title)}</div>`;
        }).join('');
        const pager = totalPages > 1
          ? `<div class="cell-pager">
               <button class="pager-btn" data-pager-prev="${key}" ${pg===0?'disabled':''}>‹</button>
               <span class="pager-dots">${pg+1}/${totalPages}</span>
               <button class="pager-btn" data-pager-next="${key}" ${pg===totalPages-1?'disabled':''}>›</button>
             </div>`
          : '';
        return `<td><div class="cell" data-goto="${p.id}|${m}"><div class="cell-page">${chips}</div>${pager}</div></td>`;
      }).join('');
      return `<tr>
        <td class="name-col"><span class="person-name">${escapeHtml(p.name)}</span><span class="pct">${stats.pct}% complete</span></td>
        ${cells}
      </tr>`;
    }).join('');
 
    const overdueTasks = state.tasks
      .filter(t=>!t.done && t.month<CUR_MONTH)
      .sort((a,b)=>a.month-b.month)
      .map(t => {
        const p = state.people.find(pp=>pp.id===t.personId);
        return `<div class="attention-row">
          <div class="who-task"><span class="p-name">${p?`<span class="person-name">${escapeHtml(p.name)}</span>`:'?'}</span><span>${escapeHtml(t.title)}</span></div>
          <span class="mono" style="color:var(--red)">${MONTH_NAMES[t.month-1]} · overdue</span>
        </div>`;
      }).join('');
 
    return `
      <div class="stat-row">
        <div class="stat"><div class="num display">${totals}</div><div class="lbl">Total tasks</div></div>
        <div class="stat teal"><div class="num display">${done}</div><div class="lbl">Completed</div></div>
        <div class="stat red"><div class="num display">${overdue}</div><div class="lbl">Overdue</div></div>
      </div>
      ${renderDeliverablesRow()}
      <div class="grid-wrap">
        <table>
          <thead><tr><th class="name-col">Team member</th>${MONTH_NAMES.map(m=>`<th>${m}</th>`).join('')}</tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
      <div class="attention">
        <h3>Needs attention</h3>
        ${overdueTasks || '<div class="attention-empty">Nothing overdue right now.</div>'}
      </div>
      <div class="attention" style="margin-top:16px;">
        <h3 style="color:var(--indigo);">Insights — This Month</h3>
        ${generateMonthlyInsights()}
      </div>
      <div class="attention" style="margin-top:16px;">
        <h3 style="color:var(--indigo);">Insights — Full Financial Year</h3>
        ${generateYearlyInsights()}
      </div>
    `;
  }
 
  function csvSafe(s){
    s = String(s);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
  }

  function computeMonthlyBreakdown(){
    return MONTH_NAMES.map((mn,idx)=>{
      const m = idx+1;
      const list = state.tasks.filter(t=>t.month===m);
      const done = list.filter(t=>t.done).length;
      const overdue = list.filter(t=>!t.done && m<CUR_MONTH).length;
      return { month: mn, total:list.length, done, overdue, pct: list.length ? Math.round(done/list.length*100) : 0 };
    });
  }

  function personSummaries(){
    return state.people
      .map(p => ({ p, stats: personStats(p.id) }))
      .sort((a,b) => a.stats.pct - b.stats.pct);
  }

  /**
   * Renders the monthly Total/Done/Overdue/Completion% breakdown as a
   * plain inline SVG line chart -- no external charting library, so it
   * keeps working inside the Apps Script HtmlService sandbox with no
   * extra script tags. Counts (Total/Done/Overdue) share the left axis;
   * Completion % uses the right axis and a dashed line so it's visually
   * distinct even for readers who can't tell the colors apart.
   */
  function renderMonthlyLineChart(data){
    const w = 680, h = 260;
    const padL = 40, padR = 40, padT = 16, padB = 30;
    const chartW = w - padL - padR;
    const chartH = h - padT - padB;
    const n = data.length;
    const step = n > 1 ? chartW / (n - 1) : 0;
    const countMax = Math.max(1, ...data.map(d => d.total));
    const countTop = Math.ceil(countMax * 1.15) || 1;

    const xAt = i => padL + i * step;
    const yCount = v => padT + chartH - (v / countTop) * chartH;
    const yPct = v => padT + chartH - (v / 100) * chartH;

    const pathFor = (values, yFn) =>
      values.map((v, i) => `${i === 0 ? 'M' : 'L'}${xAt(i).toFixed(1)},${yFn(v).toFixed(1)}`).join(' ');

    const dots = (values, yFn, color) =>
      values.map((v, i) => `<circle cx="${xAt(i).toFixed(1)}" cy="${yFn(v).toFixed(1)}" r="3" fill="${color}" />`).join('');

    const gridFracs = [0, 0.25, 0.5, 0.75, 1];
    const gridLines = gridFracs.map(f => {
      const y = padT + chartH - f * chartH;
      return `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${w - padR}" y2="${y.toFixed(1)}" stroke="var(--border)" stroke-width="1" />`;
    }).join('');
    const countLabels = gridFracs.map(f => {
      const y = padT + chartH - f * chartH;
      return `<text x="${padL - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--text-muted)" font-family="'IBM Plex Mono', monospace">${Math.round(f * countTop)}</text>`;
    }).join('');
    const pctLabels = gridFracs.map(f => {
      const y = padT + chartH - f * chartH;
      return `<text x="${w - padR + 8}" y="${(y + 4).toFixed(1)}" text-anchor="start" font-size="10" fill="var(--text-muted)" font-family="'IBM Plex Mono', monospace">${Math.round(f * 100)}%</text>`;
    }).join('');
    const monthLabels = data.map((d, i) =>
      `<text x="${xAt(i).toFixed(1)}" y="${h - 8}" text-anchor="middle" font-size="10" fill="var(--text-muted)" font-family="'IBM Plex Mono', monospace">${d.month}</text>`
    ).join('');

    const totalVals = data.map(d => d.total);
    const doneVals = data.map(d => d.done);
    const overdueVals = data.map(d => d.overdue);
    const pctVals = data.map(d => d.pct);

    return `
      <svg viewBox="0 0 ${w} ${h}" width="100%" style="display:block;max-width:100%;" role="img" aria-label="Task totals, completions, overdue counts, and completion percentage by month">
        ${gridLines}
        ${countLabels}
        ${pctLabels}
        ${monthLabels}
        <path d="${pathFor(totalVals, yCount)}" fill="none" stroke="var(--indigo)" stroke-width="2" />
        <path d="${pathFor(doneVals, yCount)}" fill="none" stroke="var(--green)" stroke-width="2" />
        <path d="${pathFor(overdueVals, yCount)}" fill="none" stroke="var(--red)" stroke-width="2" />
        <path d="${pathFor(pctVals, yPct)}" fill="none" stroke="var(--amber)" stroke-width="2" stroke-dasharray="4 3" />
        ${dots(totalVals, yCount, 'var(--indigo)')}
        ${dots(doneVals, yCount, 'var(--green)')}
        ${dots(overdueVals, yCount, 'var(--red)')}
        ${dots(pctVals, yPct, 'var(--amber)')}
      </svg>
      <div class="chart-legend" style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--text-muted);font-family:'IBM Plex Mono', monospace;">
        <span><span style="display:inline-block;width:10px;height:10px;background:var(--indigo);border-radius:2px;margin-right:5px;"></span>Total</span>
        <span><span style="display:inline-block;width:10px;height:10px;background:var(--green);border-radius:2px;margin-right:5px;"></span>Done</span>
        <span><span style="display:inline-block;width:10px;height:10px;background:var(--red);border-radius:2px;margin-right:5px;"></span>Overdue</span>
        <span><span style="display:inline-block;width:10px;height:10px;background:var(--amber);border-radius:2px;margin-right:5px;"></span>Completion %</span>
      </div>
    `;
  }

  function buildWeeklyReportCsv(){
    const totals = state.tasks.length;
    const done = state.tasks.filter(t=>t.done).length;
    const overdue = state.tasks.filter(t=>!t.done && t.month<CUR_MONTH).length;
    const pct = totals ? Math.round(done/totals*100) : 0;
    const now = new Date();

    const lines = [];
    lines.push('FY Work Plan - Weekly Manager Report');
    lines.push('Generated,' + now.toLocaleDateString(undefined,{weekday:'long',day:'2-digit',month:'short',year:'numeric'}));
    lines.push('Financial Year,' + fyLabel);
    lines.push('');
    lines.push('OVERALL SUMMARY');
    lines.push('Total tasks,' + totals);
    lines.push('Completed,' + done);
    lines.push('Overdue,' + overdue);
    lines.push('Completion %,' + pct);
    lines.push('');
    lines.push('PER-PERSON SUMMARY');
    lines.push('Name,Total,Done,Overdue,Completion %');
    personSummaries().forEach(x=>{
      lines.push([csvSafe(x.p.name), x.stats.total, x.stats.done, x.stats.overdue, x.stats.pct].join(','));
    });
    lines.push('');
    lines.push('OVERDUE TASKS THIS MONTH (' + MONTH_NAMES[CUR_MONTH-1] + ')');
    lines.push('Person,Task');
    state.tasks.filter(t=>!t.done && t.month===CUR_MONTH).forEach(t=>{
      const p = state.people.find(pp=>pp.id===t.personId);
      lines.push([csvSafe(p ? p.name : '?'), csvSafe(t.title)].join(','));
    });
    if (snapshots && snapshots.length){
      lines.push('');
      lines.push('WEEKLY SNAPSHOT HISTORY');
      lines.push('Week of,Total,Done,Overdue,Completion %');
      snapshots.slice(-12).forEach(s=>{
        const d = new Date(s.date);
        const dateStr = isNaN(d) ? s.date : d.toLocaleDateString(undefined,{day:'2-digit',month:'short',year:'numeric'});
        const spct = s.totalTasks ? Math.round((s.done/s.totalTasks)*100) : 0;
        lines.push([csvSafe(dateStr), s.totalTasks, s.done, s.overdue, spct].join(','));
      });
    }
    return lines.join('\n');
  }

  function downloadWeeklyReport(){
    const csv = buildWeeklyReportCsv();
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const now = new Date();
    const stamp = now.getFullYear() + String(now.getMonth()+1).padStart(2,'0') + String(now.getDate()).padStart(2,'0');
    a.href = url;
    a.download = `weekly-report-${fyLabel.replace(/\s+/g,'')}-${stamp}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

