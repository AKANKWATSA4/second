      </div>
      ${deliverablesFormOpen ? renderDeliverablesForm() : ''}
    ` : '';
 
    const banner = (!isManager && targetId!==me) ? `<div class="readonly-banner">
      <span>Viewing ${person?`<span class="person-name">${escapeHtml(person.name)}</span>`:''}'s tasks — read only.</span>
      <button data-backtomine="1">Back to my tasks</button>
    </div>` : '';
 
    const monthTabs = MONTH_NAMES.map((mn,idx)=>{
      const m = idx+1;
      return `<div class="month-tab ${m===activeMonth?'active':''} ${m===CUR_MONTH?'now':''}" data-month="${m}">${mn}</div>`;
    }).join('');
 
    const list = tasksFor(targetId, activeMonth);
    const tasksHtml = list.length ? list.map(t=>{
      const st = t.done ? 'done' : (activeMonth<CUR_MONTH ? 'overdue' : (activeMonth===CUR_MONTH ? 'due' : ''));
      const stampTxt = t.done ? 'DONE' : (activeMonth<CUR_MONTH ? 'LATE' : (activeMonth===CUR_MONTH ? 'DUE' : ''));
      return `<div class="task ${t.done?'done':''}">
        <div class="check" data-toggle="${t.id}" style="${canToggle?'':'pointer-events:none;opacity:.5;'}">${t.done?'✓':''}</div>
        <div class="task-title">${escapeHtml(t.title)}</div>
        ${stampTxt?`<div class="stamp ${st}">${stampTxt}</div>`:''}
        ${canEdit?`<button class="del" data-del="${t.id}">✕</button>`:''}
      </div>`;
    }).join('') : `<div class="empty-month">No tasks logged for ${MONTH_NAMES[activeMonth-1]} yet.</div>`;
 
    const addRow = canAddTask ? `
      <div class="add-row">
        <input type="text" id="newTaskInput" placeholder="Add a task for ${person?escapeHtml(person.name):''} — ${MONTH_NAMES[activeMonth-1]}…" />
        <select id="newTaskStrategic">
          <option value="">Strategic objective…</option>
          ${strategicObjectives().map(o=>`<option value="${o.id}">${escapeHtml(o.name)}</option>`).join('')}
        </select>
        <select id="newTaskGoal"><option value="">Planned goal…</option></select>
        <select id="newTaskIntervention"><option value="">Intervention…</option></select>
        <button id="addTaskBtn">Add</button>
      </div>` : '';
 
    return `
      ${managerPicker}
      ${deliverablesToggle}
      ${banner}
      <div class="month-tabs">${monthTabs}</div>
      <div class="task-list">${tasksHtml}</div>
      ${addRow}
    `;
  }
 
  function attachBodyHandlers(){
    root.querySelectorAll('[data-goto]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const [pid, m] = el.dataset.goto.split('|');
        viewingPersonId = pid;
        activeMonth = parseInt(m,10);
        activeTab = 'mytasks';
        render();
      });
    });
    root.querySelectorAll('[data-month]').forEach(el=>{
      el.addEventListener('click', ()=>{ activeMonth = parseInt(el.dataset.month,10); render(); });
    });
    root.querySelectorAll('[data-pager-prev]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const key = el.dataset.pagerPrev;
        cellPage[key] = Math.max(0, (cellPage[key]||0) - 1);
        render();
      });
    });
    root.querySelectorAll('[data-pager-next]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const key = el.dataset.pagerNext;
        cellPage[key] = (cellPage[key]||0) + 1;
        render();
      });
    });
    root.querySelectorAll('[data-deliv-pager-prev]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const key = el.dataset.delivPagerPrev;
        deliverablePage[key] = Math.max(0, (deliverablePage[key]||0) - 1);
        render();
      });
    });
    root.querySelectorAll('[data-deliv-pager-next]').forEach(el=>{
      el.addEventListener('click', (e)=>{
        e.stopPropagation();
        const key = el.dataset.delivPagerNext;
        deliverablePage[key] = (deliverablePage[key]||0) + 1;
        render();
      });
    });
    root.querySelectorAll('[data-toggle]').forEach(el=>{
      el.addEventListener('click', async ()=>{
        const id = el.dataset.toggle;
        const t = state.tasks.find(x=>x.id===id);
        if (!t || me==='manager' || t.personId!==me) return;
        t.done = !t.done;
        t.doneAt = t.done ? Date.now() : null;
        if (!apiConfigured()){ render(); return; }
        render();
        try {
          state = await apiPost('toggleDone', { id, actingAs: me });
          snapshotGood();
          storageOk = true;
          lastErrorMessage = null;
        } catch(e){
          state = lastGoodState ? JSON.parse(JSON.stringify(lastGoodState)) : state;
          storageOk = false;
          lastErrorMessage = e.message || String(e);
        }
        render();
      });
    });
    root.querySelectorAll('[data-del]').forEach(el=>{
      el.addEventListener('click', async ()=>{
        const id = el.dataset.del;
        const t = state.tasks.find(x=>x.id===id);
        if (!t || me!=='manager') return;
        state.tasks = state.tasks.filter(x=>x.id!==id);
        if (!apiConfigured()){ render(); return; }
        render();
        try {
          state = await apiPost('deleteTask', { id, actingAs: me });
          snapshotGood();
          storageOk = true;
          lastErrorMessage = null;
        } catch(e){
          state = lastGoodState ? JSON.parse(JSON.stringify(lastGoodState)) : state;
          storageOk = false;
          lastErrorMessage = e.message || String(e);
        }
        render();
      });
    });
    root.querySelectorAll('[data-del-deliverable]').forEach(el=>{
      el.addEventListener('click', ()=> deleteDeliverable(el.dataset.delDeliverable));
    });
    const backBtn = root.querySelector('[data-backtomine]');
    if (backBtn) backBtn.addEventListener('click', ()=>{ viewingPersonId=null; render(); });
 
    const managerSel = document.getElementById('managerPersonSelect');
    if (managerSel){
      managerSel.addEventListener('change', ()=>{
        viewingPersonId = managerSel.value;
        render();
      });
    }

    const toggleDelivBtn = document.getElementById('toggleDeliverablesBtn');
    if (toggleDelivBtn){
      toggleDelivBtn.addEventListener('click', ()=>{
        deliverablesFormOpen = !deliverablesFormOpen;
        render();
      });
    }

    const addDelivBtn = document.getElementById('addDeliverableBtn');
    if (addDelivBtn){
      addDelivBtn.addEventListener('click', addDeliverable);
      const delivInput = document.getElementById('newDeliverableInput');
      if (delivInput){
        delivInput.addEventListener('keydown', e=>{
          if (e.key==='Enter') addDeliverable();
        });
      }
    }
 
    const addBtn = document.getElementById('addTaskBtn');
    if (addBtn){
      addBtn.addEventListener('click', addTask);
      document.getElementById('newTaskInput').addEventListener('keydown', e=>{
        if (e.key==='Enter') addTask();
      });
    }

    // Cascading Strategic Objective -> Planned Goal -> Intervention
    // pickers on the task-add row. These just rewrite each other's
    // <option> lists in place -- no full render() needed, so the
    // person doesn't lose anything they've already typed.
    const stratSel = document.getElementById('newTaskStrategic');
    const goalSel = document.getElementById('newTaskGoal');
    const intSel = document.getElementById('newTaskIntervention');
    if (stratSel && goalSel && intSel){
      stratSel.addEventListener('change', ()=>{
        const goals = plannedGoalsOf(stratSel.value);
        goalSel.innerHTML = '<option value="">Planned goal…</option>' +
          goals.map(g=>`<option value="${g.id}">${escapeHtml(g.name)}</option>`).join('');
        intSel.innerHTML = '<option value="">Intervention…</option>';
      });
      goalSel.addEventListener('change', ()=>{
        const interventions = interventionsOf(goalSel.value);
        intSel.innerHTML = '<option value="">Intervention…</option>' +
          interventions.map(iv=>`<option value="${iv.id}">${escapeHtml(iv.name)}</option>`).join('');
      });
    }

    root.querySelectorAll('[data-panel]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const level = el.dataset.panel;
        objectivesManagePanel = (objectivesManagePanel===level) ? null : level;
        render();
      });
    });

    const addLevelBtn = document.getElementById('addLevelBtn');
    if (addLevelBtn){
      addLevelBtn.addEventListener('click', ()=> addObjectiveLevel(addLevelBtn.dataset.level));
      const levelInput = document.getElementById('newLevelName');
      if (levelInput){
        levelInput.addEventListener('keydown', e=>{
          if (e.key==='Enter') addObjectiveLevel(addLevelBtn.dataset.level);
        });
      }
    }

    const downloadBtn = document.getElementById('downloadReportBtn');
    if (downloadBtn) downloadBtn.addEventListener('click', downloadWeeklyReport);
  }
 
  async function addTask(){
    const input = document.getElementById('newTaskInput');
    const title = input.value.trim();
    if (!title || !me) return;
    const isManager = me === 'manager';
    // Mirrors renderMyTasks()'s target resolution: the manager can add to
    // whoever they're assigning to, everyone else can only add to
    // themselves -- even if viewingPersonId is somehow stale, this keeps
    // a person from adding a task onto a teammate's list.
    const targetId = isManager
      ? (viewingPersonId || (state.people[0] && state.people[0].id))
      : me;
    if (!targetId) return;
    if (!isManager && targetId !== me) return;
    // A task ties to the Intervention only -- the Strategic Objective
    // and Planned Goal above it are implied by the chain.
    const intSelect = document.getElementById('newTaskIntervention');
    const objectiveId = intSelect ? (intSelect.value || null) : null;
    const tempId = 'temp'+Date.now()+Math.random().toString(16).slice(2);
    state.tasks.push({ id: tempId, personId: targetId, month: activeMonth, title, done:false, doneAt:null, objectiveId });
    input.value = '';
    if (!apiConfigured()){ render(); return; }
    render();
    try {
      state = await apiPost('addTask', { personId: targetId, month: activeMonth, title, objectiveId: objectiveId||'', actingAs: me });
      snapshotGood();
      storageOk = true;
      lastErrorMessage = null;
    } catch(e){
      if (lastGoodState){
        state = JSON.parse(JSON.stringify(lastGoodState));
      } else {
        state.tasks = state.tasks.filter(t=>t.id!==tempId);
      }
      storageOk = false;
      lastErrorMessage = e.message || String(e);
    }
    render();
  }

  async function addDeliverable(){
    const input = document.getElementById('newDeliverableInput');
    const monthSel = document.getElementById('deliverableMonthSelect');
    if (!input || !monthSel || me!=='manager') return;
    const title = input.value.trim();
    const month = parseInt(monthSel.value, 10);
    if (!title || !month) return;
    const tempId = 'tempdv'+Date.now()+Math.random().toString(16).slice(2);
    state.deliverables = state.deliverables || [];
    state.deliverables.push({ id: tempId, month, title, createdAt: Date.now() });
    input.value = '';
    if (!apiConfigured()){ render(); return; }
    render();
    try {
      state = await apiPost('addDeliverable', { month, title, actingAs: me });
      state.deliverables = state.deliverables || [];
      snapshotGood();
      storageOk = true;
      lastErrorMessage = null;
    } catch(e){
      if (lastGoodState){
        state = JSON.parse(JSON.stringify(lastGoodState));
      } else {
        state.deliverables = (state.deliverables||[]).filter(d=>d.id!==tempId);
      }
      storageOk = false;
      lastErrorMessage = e.message || String(e);
    }
    render();
  }

  async function deleteDeliverable(id){
    if (me!=='manager') return;
    const d = (state.deliverables||[]).find(x=>x.id===id);
    if (!d) return;
    state.deliverables = state.deliverables.filter(x=>x.id!==id);
    if (!apiConfigured()){ render(); return; }
    render();
    try {
      state = await apiPost('deleteDeliverable', { id, actingAs: me });
      state.deliverables = state.deliverables || [];
      snapshotGood();
      storageOk = true;
      lastErrorMessage = null;
    } catch(e){
      state = lastGoodState ? JSON.parse(JSON.stringify(lastGoodState)) : state;
      storageOk = false;
      lastErrorMessage = e.message || String(e);
    }
    render();
  }
 
  async function addObjectiveLevel(level){
    const nameInput = document.getElementById('newLevelName');
    const parentSel = document.getElementById('newLevelParent');
    if (!nameInput) return;
    const name = nameInput.value.trim();
    if (!name || me!=='manager') return;
    const parentId = parentSel ? (parentSel.value || '') : '';
    if (level !== 'strategic' && !parentId) return; // goal/intervention need a parent picked
    if (!apiConfigured()){
      // Nothing can be saved without a configured backend -- leave
      // the typed text in place instead of silently discarding it.
      storageOk = false;
      render();
      return;
    }
    // Optimistic update: show the new objective immediately, the same way
    // addTask() does, rather than waiting on the network round-trip.
    const tempId = 'temp'+Date.now()+Math.random().toString(16).slice(2);
    state.objectives = state.objectives || [];
    state.objectives.push({ id: tempId, name, parentId });
    nameInput.value = '';
    render();
    try {
      state = await apiPost('addObjective', { name, parentId, actingAs: me });
      snapshotGood();
      storageOk = true;
      lastErrorMessage = null;
      // render() rebuilds the panel with the server's real entry now in
      // state, reconciling the temp placeholder with the permanent one.
      render();
    } catch(e){
      if (lastGoodState){
        state = JSON.parse(JSON.stringify(lastGoodState));
      } else {
        state.objectives = (state.objectives||[]).filter(o=>o.id!==tempId);
      }
      storageOk = false;
      lastErrorMessage = e.message || String(e);
      render();
      // The save failed, so restore what they typed instead of
      // leaving the field blank with no indication anything went wrong.
      const freshInput = document.getElementById('newLevelName');
      if (freshInput){ freshInput.value = name; freshInput.focus(); }
    }
  }
 
  document.getElementById('whoSelect').addEventListener('change', async (e)=>{
    await setMe(e.target.value);
    viewingPersonId = null;
    render();
  });
  root.querySelectorAll('.tab').forEach(t=>{
    t.addEventListener('click', async ()=>{
      activeTab = t.dataset.tab;
      if (activeTab==='mytasks') viewingPersonId=null;
      if (activeTab==='reports') await loadSnapshots();
      render();
    });
  });
  document.getElementById('refreshBtn').addEventListener('click', async (e)=>{
    const btn = e.currentTarget;
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '↻ syncing…';
    await loadState(false);
    if (activeTab==='reports') await loadSnapshots();
    render();
    // re-fetch the (possibly re-rendered) button since render() rebuilds nothing outside topbar, but be safe
    const btnAfter = document.getElementById('refreshBtn');
    if (btnAfter){
      btnAfter.textContent = originalText;
      btnAfter.disabled = false;
    }
  });
  document.getElementById('editNamesBtn').addEventListener('click', ()=>{
    editNamesOpen = true;
    renderEditNamesModal();
  });
 
  (async function init(){
    refreshClock();
    await loadState(true);
    await loadMe();
    await loadSnapshots();
    render();
    setInterval(async ()=>{
      await loadState(false);
      if (activeTab==='reports') await loadSnapshots();
      const active = document.activeElement;
      const modal = document.getElementById('editNamesModal');
      const withinWidget = active && (root.contains(active) || (modal && modal.contains(active)));
      const isTyping = withinWidget &&
        (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT');
      // Don't redraw the screen out from under someone mid-command (typing a task, editing a name).
      // State is still refreshed in the background; the screen catches up on their next action.
      if (!isTyping) render();
    }, POLL_MS);
    setInterval(()=>{
      const monthOrYearChanged = refreshClock();
      if (monthOrYearChanged) render();
    }, 60000);
  })();
})();
</script>
