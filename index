  #fy-ledger-root .stamp.done { color: var(--teal); border-color: var(--teal); }
  #fy-ledger-root .stamp.overdue { color: var(--red); border-color: var(--red); }
  #fy-ledger-root .stamp.due { color: #FFE873; border-color: var(--amber); }
  #fy-ledger-root .del { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 15px; padding: 4px; flex: none; }
  #fy-ledger-root .del:hover { color: var(--red); }

  #fy-ledger-root .add-row { display: flex; gap: 8px; margin-top: 12px; }
  #fy-ledger-root .add-row input {
    flex: 1; background: var(--panel-alt); border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; padding: 9px 12px; font-size: 13.5px; font-family: inherit;
  }
  #fy-ledger-root .add-row select {
    background: var(--panel-alt); border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; padding: 9px 10px; font-size: 12.5px; font-family: inherit; max-width: 200px;
  }
